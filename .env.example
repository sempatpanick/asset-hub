# Copy to .env. Generate unique hexadecimal secrets; never commit the real file.
APP_ENV=production
PUBLIC_ORIGIN=https://assets.example.com
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
REDIS_PASSWORD=
DATA_ROOT=/srv/assethub
BACKUP_PATH=/mnt/assethub-backup
# Set false temporarily to run without retained backups or deleted-asset restore.
BACKUP_ENABLED=true
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3005
API_PORT=8085
POSTGRES_PORT=5435
REDIS_PORT=6385
# Optional: leave blank when using the existing tunnel on the Orange Pi.
# Only used when enabling AssetHub's separate tunnel profile.
TUNNEL_TOKEN=
# Ingestion requires a 32-byte random master key encoded as 64 hex characters.
# Store a recovery copy of this key independently of PostgreSQL and the backup.
STORAGE_PROVIDER=telegram
STAGING_LIMIT_BYTES=21474836480
CACHE_LIMIT_BYTES=10737418240
DISK_RESERVE_PERCENT=10
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
ASSET_MASTER_KEY=
SIGNED_URL_KEY=
